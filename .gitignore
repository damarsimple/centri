agent-backend/vinsa_export_questions_backup_200909/

# LaTeX skill (separate tool)
agent-backend/latex-skill/

# Presentation assets — track LaTeX/Markdown source only.
# Skip built PDFs, figures, LaTeX build artifacts, and old/backup snapshots.
presentation/**
!presentation/**/
!presentation/**/*.tex
!presentation/**/*.md
# ...and the scripts that BUILD the figures. The technical report's generators were
# one-offs that got lost, leaving its PNGs as the only copy and forcing them past the
# repo-wide *.png rule. Keeping the generator means a figure can be rebuilt from a run.
!presentation/**/*.py
presentation/_backup_*/
presentation/_old/

# Video files (should not be in git)
*.MOV
*.mov
*.mp4
*.MP4

# Per-template run outputs
agent-backend/templates/*/analysis_output/
agent-backend/templates/*/api_cache.json
agent-backend/templates/*/frequency_meta.json
agent-backend/templates-reshoot/*/analysis_output/

# Session logs
*.jsonl

# Export backups
agent-backend/vinsa_export_single_backup_*/

# Scratch notes & scripts
note-*
print-props/
!presentation/note-from-prof.md

# Editor config
.vscode/

# Sweep/runtime artifacts
agent-backend/.rerun_jobmap.tsv

# Paper build artifacts (keep the .tex source; *.aux/*.log/*.out already ignored above)
paper/*.pdf
technical-report/*.pdf
